{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DaiDai Hub",
  "version": "0.1.0",
  "identifier": "com.daidai.hub",
  "build": {
    "beforeDevCommand": "pnpm dev --host 127.0.0.1 --port 5173",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "DaiDai Hub", "width": 1200, "height": 800, "minWidth": 920, "minHeight": 640, "resizable": true, "center": true }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png"],
    "createUpdaterArtifacts": false
  }
}
