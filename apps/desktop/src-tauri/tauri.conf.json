{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AllMyTools",
  "version": "0.1.0",
  "identifier": "com.allmytools.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @allmytools/desktop dev",
    "beforeBuildCommand": "pnpm --filter @allmytools/desktop build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AllMyTools",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
